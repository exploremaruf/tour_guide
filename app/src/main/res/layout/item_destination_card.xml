<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"  android:layout_margin="6dp">

    <ImageView
        android:id="@+id/ivDestinationImage"
        android:layout_width="match_parent"
        android:layout_height="220dp"       android:scaleType="centerCrop"
        android:background="@drawable/bg_card_rounded"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignBottom="@id/ivDestinationImage"
        android:layout_alignTop="@id/ivDestinationImage"
        android:background="@drawable/bg_gradient_overlay"/>

    <TextView
        android:id="@+id/tvDestinationTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_margin="16dp"
        android:layout_alignBottom="@id/ivDestinationImage"/>
</RelativeLayout>