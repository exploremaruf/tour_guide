<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <gradient
                android:startColor="#D1D5CDCD"
                android:centerColor="#2C716A6A"
                android:endColor="#6A383838"
                android:angle="270" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="#00FFFF" />
        </shape>
    </item>
</layer-list>